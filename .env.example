# Hedera Performance Testing Framework Configuration

# Hedera Operator Account ID
OPERATOR_ID=

# Hedera Operator Private Key
OPERATOR_KEY=

# Hedera Network (testnet, mainnet, previewnet, or custom JSON nodes)
HEDERA_NETWORK=testnet

# Custom network nodes (JSON format, optional)
# HEDERA_NODES={"0.0.3":"34.94.106.61:50211"}

# Mirror node API endpoint (optional)
# HEDERA_MIRROR_NODE=https://testnet.mirrornode.hedera.com

# Maximum concurrent connections
MAX_CONNECTIONS=10

# Test Configuration
TEST_DURATION=300
TEST_CONCURRENCY=10
TEST_RAMP_UP=30
TEST_SCENARIOS=token-transfer,approval
# TEST_ITERATIONS=100

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1000
BACKOFF_MULTIPLIER=2

# Logging Configuration
LOG_LEVEL=info
# LOG_FILE=./logs/hedera-perf.log

# Metrics Configuration
METRICS_INTERVAL=1000
METRICS_FORMATS=json,csv
METRICS_OUTPUT_DIR=./results