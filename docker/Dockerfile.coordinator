# Dockerfile for Load Test Coordinator
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy application code
COPY scripts/ ./scripts/
COPY contracts/ ./contracts/

# Create results directory
RUN mkdir -p /app/results

# Expose ports
EXPOSE 3000 9090

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/test/status', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Run the coordinator
CMD ["node", "scripts/distributed/coordinator.js"]